# Указания для хостинга: как отдавать файлы браузеру.
# Этот формат понимают Netlify и Cloudflare Pages — самые ходовые
# бесплатные хостинги для таких сайтов. Другие хостинги файл просто
# не заметят, вреда не будет.

# --- Всё подряд: базовая защита ---
/*
  # Запрещаем показывать сайт внутри рамки на чужой странице.
  # Без этого мошенник может встроить ваш сайт к себе и подсунуть
  # поверх невидимые кнопки — человек думает, что нажимает у вас.
  X-Frame-Options: DENY

  # Запрещаем браузеру угадывать тип файла. Иначе картинку с хитрым
  # содержимым он может попробовать выполнить как программу.
  X-Content-Type-Options: nosniff

  # Не сообщаем чужим сайтам полный адрес страницы, с которой ушёл человек.
  Referrer-Policy: strict-origin-when-cross-origin

  # Отключаем то, чем сайт всё равно не пользуется. Если однажды на него
  # проникнет чужой скрипт, он не сможет попросить камеру или геолокацию.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# --- Шрифты и фотографии: хранить в кэше год ---
# Эти файлы не меняются. Пусть браузер скачает их один раз и больше
# не спрашивает — второе посещение сайта станет мгновенным.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/photos/*
  Cache-Control: public, max-age=31536000, immutable

# --- Стили и скрипты ---
# В их именах есть набор букв вроде BaseLayout.D9Ymhc2Q.css — он меняется
# при каждой правке. Поэтому старую версию тоже можно хранить сколько угодно:
# после изменений имя станет другим, и браузер скачает новую сам.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
