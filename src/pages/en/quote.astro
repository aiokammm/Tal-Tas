import QuotePage from "../../components/pages/QuotePage.astro";
import { getPages } from "../../i18n/utils";

const lang = "en" as const;
const t = getPages(lang);
---

<BaseLayout lang={lang} title={t.quote.title} description={t.quote.intro}>
  <QuotePage lang={lang} />
</BaseLayout>
