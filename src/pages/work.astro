---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkPage from "../components/pages/WorkPage.astro";
import { getPages } from "../i18n/utils";

const lang = "ru" as const;
const t = getPages(lang);
---

<BaseLayout lang={lang} title={t.work.title} description={t.work.intro}>
  <WorkPage lang={lang} />
</BaseLayout>
