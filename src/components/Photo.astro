---
/**
 * Фотография с запасным вариантом.
 *
 * Работает так: при сборке сайта проверяем, лежит ли файл в папке
 * public/photos. Если лежит — показываем фотографию. Если нет —
 * показываем серую заглушку с подписью, что сюда нужно.
 *
 * Зачем так сложно: фотографии появляются постепенно. Без этого пришлось бы
 * либо ждать все сразу, либо каждый раз лезть в код и менять заглушку
 * на картинку вручную. А так — положили файл, обновили страницу, готово.
 *
 * Когда все фотографии будут на месте, этот компонент можно упростить.
 * Но и оставить не жалко: он же и страхует от пропавшего файла.
 */
import { existsSync } from "node:fs";
import Placeholder from "./Placeholder.astro";

interface Props {
  /** Путь внутри папки photos, например "work/alatau-2k-before.webp" */
  src: string;
  /** Описание для незрячих и на случай, если картинка не загрузилась */
  alt: string;
  ratio?: string;
  tone?: "dark" | "light";
  /** Что написать на заглушке, пока фотографии нет */
  placeholder: string;
  /** Первая картинка на экране грузится сразу, остальные — по мере прокрутки */
  eager?: boolean;
}

const {
  src,
  alt,
  ratio = "3/2",
  tone = "light",
  placeholder,
  eager = false,
} = Astro.props;

const exists = existsSync(`public/photos/${src}`);

/* Ширина и высота нужны браузеру заранее: без них страница «прыгает»,
   когда картинка догружается и вдруг занимает место. */
const [w, h] = ratio.split("/").map(Number);
const width = 1200;
const height = Math.round((width * h) / w);
---

{
  exists ? (
    <img
      class="photo"
      src={`/photos/${src}`}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? "eager" : "lazy"}
      {/* Говорим браузеру, что эта картинка важнее прочих и качать
          её надо в первую очередь. Для картинки на первом экране
          это заметно ускоряет открытие сайта. */}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      style={`aspect-ratio: ${ratio}`}
    />
  ) : (
    <Placeholder label={placeholder} ratio={ratio} tone={tone} />
  )
}

<style>
  /* Высота считается из ширины и формы кадра (aspect-ratio задан в теге).
     Раньше здесь стояло height: 100% — и это ломало портреты: внутри
     сетки они растягивались по высоте самой длинной карточки и обрезали лица.

     Внутри бегунка «до/после» высота всё-таки должна быть 100% —
     там два слоя лежат друг на друге. Это отдельное правило
     прописано в BeforeAfter.astro и перекрывает это. */
  .photo {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>
